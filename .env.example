# Copia a .env; NUNCA publiques el .env. Sin valores reales, la IA entra en modo degradado.
# Para elegir modo usa el BAT correspondiente (prioriza variables de entorno).
CATALOG_BACKEND=supabase
CATALOG_FILE=data/catalog.academico.json
FALLBACK_FILE=data/catalog.academico.json
ALLOW_DEMO_RECORDS=false
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=10

# Solo si se activó Supabase en un proyecto SEPARADO de laboratorio
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Habilitar historial solo tras confirmar RLS, dominio y sesiones de prueba.
ENABLE_HISTORY=false
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:8001
